{
  "name": "@pubwave/techbrief",
  "version": "0.1.2",
  "private": false,
  "description": "A multilingual reader for tech news and indie-dev writing — AI summaries and translation, all on the local machine.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Pubwave",
  "homepage": "https://github.com/pubwave/techbrief#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubwave/techbrief.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/pubwave/techbrief/issues"
  },
  "keywords": [
    "tech-news",
    "rss",
    "ai",
    "translation",
    "summaries",
    "cli",
    "reader",
    "hacker-news",
    "devto"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "techbrief": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "node ./scripts/dev.mjs",
    "dev:session": "node ./scripts/dev.mjs --session",
    "prepublishOnly": "node ./scripts/build.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "figlet": "^1.11.0",
    "ink": "^6.8.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@pubwave/cli": "^0.1.7",
    "@techbrief/ai": "0.1.0",
    "@techbrief/converter": "0.1.0",
    "@techbrief/feed": "0.1.0",
    "@techbrief/feed-rules": "0.1.0",
    "@techbrief/ingest": "0.1.0",
    "@techbrief/pipeline": "0.1.0",
    "@techbrief/runtime": "0.1.0",
    "@techbrief/scheduler": "0.1.0",
    "@techbrief/shared": "0.1.0",
    "@types/react": "^19.2.14",
    "cheerio": "^1.2.0",
    "esbuild": "^0.27.4",
    "fast-xml-parser": "^4.5.0",
    "tar": "^7.5.13"
  }
}
